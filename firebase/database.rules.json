{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "status": {
          ".validate": "newData.hasChildren(['online','available','lastSeen']) && newData.child('online').isBoolean() && newData.child('available').isBoolean() && newData.child('lastSeen').exists()"
        },
        "info": {
          ".validate": "newData.hasChild('displayName') && newData.child('displayName').isString() && (!newData.hasChild('email') || newData.child('email').isString()) && (!newData.hasChild('photoURL') || newData.child('photoURL').isString())"
        },
        "publicKey": {
          "jwk": {
            ".write": "auth != null && auth.uid === $uid",
            ".read": "auth != null",
            ".validate": "newData.hasChildren(['kty', 'alg', 'crv', 'x', 'y']) && !newData.hasChild('d') && newData.val().toString().length < 1000",
            "kty": {
              ".validate": "newData.isString() && newData.val() === 'EC'"
            },
            "alg": {
              ".validate": "newData.isString() && newData.val() === 'ES256'"
            },
            "crv": {
              ".validate": "newData.isString() && newData.val() === 'P-256'"
            },
            "x": {
              ".validate": "newData.isString() && newData.val().length >= 40"
            },
            "y": {
              ".validate": "newData.isString() && newData.val().length >= 40"
            }
          }
        }
      }
    },
    "shareRequests": {
      "$toUid": {
        ".read": "auth != null && auth.uid === $toUid",
        "$reqId": {
          ".write": "((!data.exists() && newData.child('toUserId').val() === $toUid && newData.child('fromUserId').val() === auth.uid && newData.child('status').val() === 'pending') || (data.exists() && auth != null && auth.uid === $toUid))",
          ".validate": "newData.hasChild('requestId') && newData.child('requestId').isString() && newData.hasChild('fromUserId') && newData.child('fromUserId').isString() && newData.hasChild('toUserId') && newData.child('toUserId').isString()"
        }
      }
    },
    "signaling": {
      "$sessionId": {
        ".read": "auth != null && root.child('signaling').child($sessionId).child('peers').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('signaling').child($sessionId).child('peers').child(auth.uid).val() === true",
        "peers": {
          "$peerUid": {
            ".write": "auth != null && auth.uid === $peerUid",
            ".validate": "newData.val() === true"
          }
        },
        "offers": {
          "$offerUid": {
            ".write": "auth != null && auth.uid === $offerUid",
            ".read": "auth != null && root.child('signaling').child($sessionId).child('peers').child(auth.uid).val() === true",
            ".validate": "newData.hasChild('sdp') && newData.child('sdp').isString() && newData.child('from').val() === $offerUid"
          }
        },
        "answers": {
          "$answerUid": {
            ".write": "auth != null && auth.uid === $answerUid",
            ".read": "auth != null && root.child('signaling').child($sessionId).child('peers').child(auth.uid).val() === true",
            ".validate": "newData.hasChild('sdp') && newData.child('sdp').isString() && newData.child('from').val() === $answerUid"
          }
        },
        "candidates": {
          "$candUid": {
            "$pushId": {
              ".write": "auth != null && auth.uid === $candUid",
              ".read": "auth != null && root.child('signaling').child($sessionId).child('peers').child(auth.uid).val() === true",
              ".validate": "newData.hasChild('candidate') && newData.child('candidate').isString()"
            }
          }
        },
        "e2ee": {
          "$peerUid": {
            ".write": "auth != null && auth.uid === $peerUid",
            ".read": "auth != null && root.child('signaling').child($sessionId).child('peers').child(auth.uid).val() === true",
            ".validate": "newData.hasChild('pub') && newData.child('pub').isString() && newData.hasChild('sig') && newData.child('sig').isString()"
          }
        },
        "meta": {
          "$key": {
            ".write": "auth != null && root.child('signaling').child($sessionId).child('peers').child(auth.uid).val() === true",
            ".read": "auth != null && root.child('signaling').child($sessionId).child('peers').child(auth.uid).val() === true"
          }
        }
      }
    },
    "uploads": {
      "$uploadId": {
        ".read": "auth != null && data.child('owner').val() === auth.uid",
        ".write": "auth != null && newData.child('owner').val() === auth.uid && newData.child('size').isNumber() && newData.child('size').val() <= 104857600",
        "size": {
          ".validate": "newData.isNumber() && newData.val() <= 104857600"
        },
        "mime": {
          ".validate": "newData.isString()"
        }
      }
    }
  }
}